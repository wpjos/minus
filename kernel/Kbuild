# core/ is the microkernel: arch bring-up, boot, capability & service
# registry, scheduler, syscall dispatch, and kernel logging.  Everything
# else (mm, fs, proc, drivers) is a server on top of it.
obj-y := core/
obj-y += mm/
obj-y += driver/
obj-y += fs/
obj-y += proc/

include $(TOPDIR)/scripts/Kbuild.include
